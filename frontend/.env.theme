# Public theme colors. Saving this file automatically reloads the dev preview.
# Keep hex colors quoted so the # is not interpreted as an env-file comment.
# Landing and About: PRIMARY background / BACKGROUND text.
# Community: COMMUNITY_BACKGROUND paper / COMMUNITY_PRIMARY ink.
VITE_THEME_PRIMARY="#7b2a68" # 1D46E8 #7b2a68
VITE_THEME_BACKGROUND="#FFFFFF"

# Community pages: deep blue ink on warm paper. Landing/About keep the colors above.
VITE_THEME_COMMUNITY_PRIMARY="#264960"
VITE_THEME_COMMUNITY_BACKGROUND="#F2EFE8"
